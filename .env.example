# Spring Boot backend used by the search client.
# If omitted, the AI server uses http://localhost:8080.
GANGWON_BE_BASE_URL=http://localhost:8080

# Optional Response Agent LLM rendering.
# Keep disabled by default so local tests and development do not call external APIs.
GANGWON_RESPONSE_LLM_ENABLED=false
GANGWON_RESPONSE_LLM_MODEL=gpt-4.1
OPENAI_API_KEY=

# Override only when using a compatible proxy or non-default OpenAI endpoint.
OPENAI_BASE_URL=https://api.openai.com

# Travel Profile Analyzer: rules classify the type; the LLM writes grounded Korean copy.
# If this switch is omitted, profile LLM generation is enabled when OPENAI_API_KEY exists.
GANGWON_TRAVEL_PROFILE_LLM_ENABLED=false
GANGWON_TRAVEL_PROFILE_LLM_MODEL=gpt-4.1-mini
GANGWON_TRAVEL_PROFILE_LLM_TIMEOUT_SECONDS=8

# Shared with BE's AI_INTERNAL_API_KEY. If empty, local authentication is disabled.
INTERNAL_API_KEY=
